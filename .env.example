# OpenRouter LLM (OpenAI-compatible endpoint)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_MODEL=inclusionai/ling-3.0-flash-vl

# Neon Postgres (direct for DDL/migrations, pooled -pooler for async queries)
NEON_DATABASE_URL=
NEON_DATABASE_URL_POOLED=

# Neon Auth (Managed Better Auth; JWKS defaults to {NEON_AUTH_BASE_URL}/.well-known/jwks.json)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Neon Object Storage (S3-compatible, beta; nearest region to Hyderabad is ap-southeast-1)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=

# Redis / ARQ (host port 6380 avoids collision with port 6379)
REDIS_URL=redis://127.0.0.1:6380/0

# Tesseract OCR (Windows default install path when not on PATH)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Phase 1 Web & Auth
# Generate 32+ random characters (e.g., openssl rand -base64 32 or Python secrets.token_urlsafe(32))
NEON_AUTH_COOKIE_SECRET=
# Public URL of the FastAPI server (e.g., http://localhost:8000 locally, deployed API URL in prod)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Phase 1 API CORS
# Comma-separated allowed browser origins (no trailing slash), e.g. http://localhost:3000,https://rezoooo-me.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

